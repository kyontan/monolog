<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300&display=fallback" rel="stylesheet">
<link rel="stylesheet" href="/css/ress.min.css">
<link rel="stylesheet" href="/css/codium.css">
<title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
<link rel="canonical" href="{{ site.url }}{{ page.url }}" />
<meta property="og:site_name" content="{{ site.title }}" />
<meta property="og:locale" content="ja_JP" />
<meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title }}" />
<meta property="og:type" content="website" />
<meta property="og:url" content="{{ site.url }}{{ page.url }}" />
{% if og_description %}
<meta property="og:description" content="{{ og_description }}" />
<meta name="description" content="{{ og_description }}" />
{% endif %}
{% if og_image %}
<meta property="og:image" content="{{ og_image }}" />
{% endif %}
{% if og_type == "article" %}
<meta property="og:type" content="article" />
<meta property="article:published_time" content="{{ date }}" />
{% endif %}
<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}" />
{% if og_image %}<meta name="twitter:image" content="{{ og_image }}" />{% endif %}
</head>
<body>

<header>
  <h1 id="blog-title" class="blogtitle"><a href="/" title="{{ site.title }}">{{ site.title }}</a></h1>
  <div class="description">{{ site.tagline }} </div>
</header>

<nav id="nav-head">
  <div class="menu-header">
    <ul id="menu-link" class="menu">
      {% for item in site.menu %}
      <li class="menu-item"><a href="{{ item.url }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </div>
</nav>

{{ content | safe }}

<aside id="sidebar">
  <nav id="nav-side">
    <div class="menu-header">
      <ul id="menu-link-1" class="menu">
        {% for item in site.menu %}
        <li class="menu-item"><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </nav>

  <ul>
    <li id="text-2" class="widget widget_text">
      <div class="widgetblock">
        <div class="widgettitleb"><h3 class="widgettitle">{{ site.about.title }}</h3></div>
        <div class="textwidget">{{ site.about.content | pt | safe }}</div>
      </div>
    </li>

    <li id="recent-posts-2" class="widget widget_recent_entries">
      <div class="widgetblock">
        <div class="widgettitleb"><h3 class="widgettitle">最近の投稿</h3></div>
        <ul>
          {% for p in collections.posts %}
          {% if loop.index <= 5 %}
          <li><a href="{{ p.url }}">{{ p.data.title }}</a> <span class="post-date">({{ p.data.date | wpdate(true) }})</span></li>
          {% endif %}
          {% endfor %}
        </ul>
      </div>
    </li>

    <li id="categories-3" class="widget widget_categories">
      <div class="widgetblock">
        <div class="widgettitleb"><h3 class="widgettitle">カテゴリー</h3></div>
        <ul>
          {% for c in collections.catList %}
          <li class="cat-item"><a href="/category/{{ c.slug }}/">{{ c.label }}</a> ({{ c.count }})</li>
          {% endfor %}
        </ul>
      </div>
    </li>

    <li id="search-2" class="widget widget_search">
      <div class="widgetblock">
        <form role="search" class="search-form" onsubmit="location.href='https://www.google.com/search?q='+encodeURIComponent('site:blog.monora.me '+this.q.value);return false;">
          <label>
            <span class="screen-reader-text">検索:</span>
            <input type="search" class="search-field" placeholder="検索…" value="" name="q" />
          </label>
          <input type="submit" class="search-submit" value="検索" />
        </form>
      </div>
    </li>

    <li id="annual_archive_widget-2" class="widget Annual_Archive_Widget">
      <div class="widgetblock">
        <div class="widgettitleb"><h3 class="widgettitle">Archive</h3></div>
        <ul>
          {% for y in collections.yearList %}
          <li><a href="/{{ y.year }}/">{{ y.year }}</a>&nbsp;({{ y.count }})</li>
          {% endfor %}
        </ul>
      </div>
    </li>
  </ul>
</aside>
<div class="clear"></div>
<div id="footerlink">
  <div class="alignright"><p>Proudly powered by <a href="https://www.11ty.dev/">Eleventy</a></p></div>
</div>
</body>
</html>
